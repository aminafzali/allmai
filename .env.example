# ---- AllMai AI Platform : environment template ----
# Copy to `.env` at repo root:  copy .env.example .env   (Windows)
# All values are read by backend/app/core/config.py. Every service runs
# as a direct OS install.

APP_NAME=AllMai AI Platform
ENV=dev

# PostgreSQL + pgvector (direct install)
DATABASE_URL=postgresql+psycopg2://allmai:allmai@localhost:5432/allmai

# Redis (direct install)
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# File storage backend: "local" (MVP, server disk) | "s3" (later)
STORAGE_BACKEND=local
STORAGE_LOCAL_DIR=./data/storage

# S3-compatible storage (only used when STORAGE_BACKEND=s3)
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=allmai
S3_REGION=us-east-1
S3_SECURE=false

# Auth (JWT + refresh)
JWT_SECRET=change-me-to-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30

# AI provider: "openai_compat" (OpenAI or GapGPT) | "gemini"
AI_PROVIDER=openai_compat
# GapGPT OpenAI-compatible gateway (https://gapgpt.app). For plain OpenAI use https://api.openai.com/v1
OPENAI_COMPAT_BASE_URL=https://api.gapgpt.app/v1
OPENAI_COMPAT_API_KEY=
CHAT_MODEL=gpt-4o-mini
# Gemini-via-GapGPT (RECOMMENDED, no direct Google key needed): Gemini models
# (e.g. gemini-2.5-flash-lite, gemini-2.5-flash) are called through the SAME
# OpenAI-compatible endpoint above. OCR ("gemini" provider) and Vision both
# use it; their model ids live in ai_settings (ocr.provider/model,
# vision.provider/model, editable in /admin/ai-settings, defaults are
# GapGPT-routed gemini-2.5-flash-lite). Only set GEMINI_API_KEY below if you
# want the DIRECT Google provider (AI_PROVIDER=gemini) instead.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
# Agent search tools (per-definition toggles in Agent Studio, default OFF):
# - web_search: GapGPT Responses API + web_search tool (proven live, same
#   billing/trust as every chat call — no new keys). Browser DDG is dead
#   from Iranian networks, so the client web path is a last resort only.
WEB_SEARCH_PROVIDER=gapgpt
WEB_SEARCH_FALLBACKS=ddg
WEB_SEARCH_SIDE=server
GAPGPT_SEARCH_MODEL=gpt-4o-mini
# - maps_search: browser-first Overpass radius search (no keys, no cost;
#   proven live: ~90 Kerman restaurants, ~30 with phones). overpass-server
#   runs only when the browser fails (resume remainder).
PLACES_PROVIDER=overpass
PLACES_FALLBACKS=overpass-server
# Dormant server-side upgrade paths (direct Google keys, NOT GapGPT):
# - web_search via Gemini + Google Search Grounding needs GEMINI_API_KEY.
WEB_SEARCH_MODEL=gemini-2.5-flash
# - maps_search via Google Places API (New) needs a key with Places API
#   enabled (Google-side billing).
GOOGLE_MAPS_API_KEY=

# Embeddings (swappable; DIM must match the `chunks.embedding` column)
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536

# Audio transcription (no local models in MVP). Route is selected by model id
# (panel-editable `audio.transcription` in /admin/ai-settings; the DB row wins
# over this ENV fallback):
# - "gpt-4o-mini-transcribe" (DEFAULT): AvalAI /audio/transcriptions
#   (https://docs.avalai.ir/fa/api-reference/audio). Needs AVALAI_API_KEY.
# - "whisper-1": GapGPT /audio/transcriptions (kept, switch back anytime).
# - "gemini-*" (e.g. gemini-2.5-flash-lite): Gemini-via-GapGPT chat with audio
#   input, no transcription endpoint needed (single segment, no timestamps).
WHISPER_API_MODEL=gpt-4o-mini-transcribe
# AvalAI OpenAI-compatible gateway (transcription only for now).
AVALAI_BASE_URL=https://api.avalai.ir/v1
AVALAI_API_KEY=
# Per-request transcription payload cap (whisper ~25MB): longer audio is
# split into pieces (timestamps shifted) before upload.
WHISPER_MAX_BYTES=25165824

# Video (audio-track transcription only, via imageio-ffmpeg static binary).
# Pre-ingest guards, both tunable: oversized/over-long videos are rejected.
VIDEO_MAX_BYTES=104857600
VIDEO_MAX_DURATION_S=1200
VIDEO_AUDIO_BITRATE=32k

# Excel + CSV (structured sheets via DuckDB + RAG summaries).
EXCEL_MAX_ROWS_PER_SHEET=200000
EXCEL_MAX_SHEETS=50
EXCEL_QUERY_MAX_ROWS=200
EXCEL_QUERY_TIMEOUT_S=15

# Structured PDF extraction: Gemini Flash via GapGPT (no Docling).
# Text-rich pages are structured in small batches; textless pages go
# through Gemini vision one by one. Flat pypdf stays as the loud fallback.
USE_GEMINI_PDF=true
# GapGPT-routed model id (admin can override via ai_settings extraction.pdf).
GEMINI_STRUCT_MODEL=gemini-2.5-flash
# Pages per structuring call: cost/latency knob (a 200-page book needs
# ~40 calls at 5 pages each). Loud refusal above GEMINI_STRUCT_MAX_PAGES.
GEMINI_STRUCT_PAGES_PER_CALL=5
GEMINI_STRUCT_TIMEOUT_S=120
GEMINI_STRUCT_MAX_PAGES=300
# Heavy-document worker shape: one document at a time by default.
DOCUMENT_PROCESSING_CONCURRENCY=1
DOCUMENT_PROCESSING_TIMEOUT=1800
# Textless-page detect: avg extractable chars/page below this = no text layer.
SCAN_TEXT_THRESHOLD=20
# Phase 3 Vision triage (all configurable; VISION_PAGE_TEXT_MIN_CHARS provisional).
# Needs no extra key when using Gemini-via-GapGPT (model from ai_settings
# vision.provider; verified live against the GapGPT /models list).
DOCUMENT_VISION_ENABLED=false
VISION_CAPTION_MIN_CHARS=20
VISION_PAGE_TEXT_MIN_CHARS=200
DOC_VISION_MAX_FIGURES=5
# Figure extraction (embedded PDF images): images smaller than
# this (either side, px) are treated as icons and skipped.
VISION_MIN_IMAGE_PX=120

# Backend runtime
API_HOST=127.0.0.1
API_PORT=8000
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000,http://127.0.0.1:3001
